{
  "permissions": {
    "allow": [
      "Bash(node tests/run.js)",
      "Bash(node tests/run.js --update)",
      "Bash(python tests/make_fixtures.py)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch -c:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(**/*.xlsx)",
      "Read(**/*.xls)",
      "Read(**/*.csv)"
    ]
  }
}
